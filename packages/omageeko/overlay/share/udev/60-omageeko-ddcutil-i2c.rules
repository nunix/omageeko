# omageeko: ddcutil's own rule (Arch installs it to /usr/lib/udev/rules.d;
# Tumbleweed only ships it as a sample in /usr/share/ddcutil/data). Grants the
# logged-in user access to I2C buses of display adapters, so external monitor
# brightness (Omarchy shell -> ddcutil) works without root.
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", ATTRS{class}=="0x03*", TAG+="uaccess"
