#!/bin/bash

# omarchy:summary=Set the Omarchy package channel.
# omarchy:args=<stable|rc|edge|dev>
# omageeko: Tumbleweed port: channels don't apply; omageeko follows the upstream commit pinned in its upstream.lock

case "${1:-}" in
  stable)
    echo "omageeko already follows its pinned upstream release."
    ;;
  dev)
    echo "Use omarchy-dev-link with an omarchy checkout to run upstream code directly."
    ;;
  *)
    echo "omageeko has no Omarchy package channels: bump upstream.lock in the omageeko repo and rebuild instead." >&2
    exit 1
    ;;
esac
