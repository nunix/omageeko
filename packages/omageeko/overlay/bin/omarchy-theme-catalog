#!/bin/bash

# omarchy:summary=Browse the community themes from omarchy.org and install one
# omarchy:args=[--refresh] [--list]
# omarchy:examples=omarchy theme catalog | omarchy theme catalog --list | omarchy theme catalog --refresh
# omageeko: upstream only asks for a repo URL (omarchy-theme-install). This
# opens the omarchy.org community themes in the shell's image picker, with the
# site's screenshots, the number of apps each theme styles beyond what Omarchy
# renders from colors.toml, its GitHub stars and how long ago its default
# branch last got a commit. Picking one hands its repo to omarchy-theme-install.
#
# App counts come from a tree-only shallow clone of each repo, which needs no
# GitHub API. Stars and commit dates take one batched GraphQL query per 80 repos
# through gh, so they only show when gh is logged in. Cached for a week.

CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/omageeko/theme-catalog"
INDEX_FILE="$CACHE_PATH/index.v3.tsv"
PREVIEW_DIR="$CACHE_PATH/previews"
LABEL_DIR="$CACHE_PATH/labels"
USER_THEMES_PATH="$HOME/.config/omarchy/themes"
SITE="https://omarchy.org"
MAX_AGE_DAYS=7

refresh=false
list=false
for arg in "$@"; do
  case $arg in
  --refresh) refresh=true ;;
  --list) list=true ;;
  *)
    echo "Usage: omarchy-theme-catalog [--refresh] [--list]" >&2
    exit 1
    ;;
  esac
done

# A theme file name -> the app it styles. Files Omarchy also renders from
# colors.toml count too: shipping one means the author tuned that app by hand.
# Metadata (colors.toml, icons.theme, light.mode, aether.*), images and docs
# are not apps; neither is anything unknown.
APP_MAP_AWK='
  /^hyprland\.(conf|lua)$/ { print "Hyprland"; next }
  /^hyprlock\.conf$/ { print "Hyprlock"; next }
  /^(vscode(-theme)?|vscode_colors)\.json$/ { print "VS Code"; next }
  /^(aether\.)?zed\.json$/ { print "Zed"; next }
  /^(fzf|colors)\.fish$/ { print "fish"; next }
  /^shell(\.[a-z-]+)*\.toml$/ { print "Omarchy shell"; next }
  /^btop\.theme$/ { print "btop"; next }
  /^neovim\.lua$/ { print "Neovim"; next }
  /^chromium\.theme$/ { print "Chromium"; next }
  /^walker\.css$/ { print "Walker"; next }
  /^waybar\.css$/ { print "Waybar"; next }
  /^mako\.ini$/ { print "Mako"; next }
  /^swayosd\.css$/ { print "SwayOSD"; next }
  /^alacritty\.toml$/ { print "Alacritty"; next }
  /^ghostty\.conf$/ { print "Ghostty"; next }
  /^kitty\.conf$/ { print "Kitty"; next }
  /^foot\.ini$/ { print "Foot"; next }
  /^gtk\.css$/ { print "GTK"; next }
  /^qt6ct\.conf$/ { print "Qt"; next }
  /^vencord\.theme\.css$/ { print "Discord"; next }
  /^cava_theme$/ { print "Cava"; next }
  /^wofi\.css$/ { print "Wofi"; next }
  /^warp\.yaml$/ { print "Warp"; next }
  /^keyboard\.rgb$/ { print "Keyboard RGB"; next }
  /^steam\.css$/ { print "Steam"; next }
  /^heroic\.css$/ { print "Heroic"; next }
  /^obsidian\.css$/ { print "Obsidian"; next }
  /^helix\.toml$/ { print "Helix"; next }
  /^zen\.css$/ { print "Zen"; next }
  /^firefox\.css$/ { print "Firefox"; next }
  /^superfile\.toml$/ { print "superfile"; next }
  /^pi\.json$/ { print "pi"; next }
  /^hyprland-preview-share-picker\.css$/ { print "Share picker"; next }
  /^gum[_.]env\.(lua|conf)$/ { print "gum"; next }
  /^zellij\.kdl$/ { print "Zellij"; next }
  /^eza\.yml$/ { print "eza"; next }
  /^vicinae\.toml$/ { print "Vicinae"; next }
  /^starship\.toml$/ { print "Starship"; next }
  /^fcitx5/ { print "Fcitx5"; next }
  /^claude\.json$/ { print "Claude"; next }
  /^hermes\.yaml$/ { print "Hermes"; next }
  /^t3code\.json$/ { print "T3 Code"; next }
  /^tmux.*\.conf$/ { print "tmux"; next }
  /^lazygit.*\.yml$/ { print "lazygit"; next }
  /^(spicetify|spotify)/ { print "Spotify"; next }
'

# One theme repo -> "apps<TAB>app, app, ..." on stdout. The theme lives
# in the shallowest directory holding its palette (usually the repo root).
probe_theme() {
  local repo=$1 preview=$2 slug=$3 work=$4
  local dir palette root files apps

  if [[ ! -f $PREVIEW_DIR/$slug.webp ]] &&
    curl -fsSL --max-time 30 "$SITE$preview" -o "$PREVIEW_DIR/$slug.webp.tmp"; then
    mv -f "$PREVIEW_DIR/$slug.webp.tmp" "$PREVIEW_DIR/$slug.webp"
  fi

  dir="$work/$slug"
  GIT_TERMINAL_PROMPT=0 timeout 120 git clone --quiet --depth 1 --filter=blob:none --no-checkout -- "$repo" "$dir" 2>/dev/null || return

  # Themes older than colors.toml only ship alacritty.toml; omarchy-theme-set
  # derives their palette from it.
  palette=$(git -C "$dir" ls-tree -r --name-only HEAD |
    awk -F/ '$NF == "colors.toml" { print 0 "\t" NF "\t" $0 } $NF == "alacritty.toml" { print 1 "\t" NF "\t" $0 }' |
    sort -n | head -n 1 | cut -f 3)
  if [[ -z $palette ]]; then
    rm -rf "$dir"
    return
  fi
  root=${palette%"${palette##*/}"}

  files=$(git -C "$dir" ls-tree --name-only "HEAD:$root")
  apps=$(awk "$APP_MAP_AWK" <<<"$files" | sort -u)
  rm -rf "$dir"

  # An empty list stays a field ("-"): read with a tab IFS collapses empty ones.
  printf '%s\t%s\n' "$(grep -c . <<<"$apps")" "$(paste -sd , <<<"$apps" | sed 's/,/, /g; s/^$/-/')"
}

# owner/name lines on stdin -> "owner/name<TAB>stars<TAB>YYYY-MM-DD" of the last
# commit on the default branch. Nothing when gh is missing or logged out.
fetch_stats() {
  local batch query i owner name

  command -v gh >/dev/null && gh auth status >/dev/null 2>&1 || return 0

  while mapfile -t -n 80 batch && (( ${#batch[@]} > 0 )); do
    query="{"
    for i in "${!batch[@]}"; do
      owner=${batch[$i]%%/*}
      name=${batch[$i]#*/}
      query+=" r$i: repository(owner: \"$owner\", name: \"$name\") { stargazerCount"
      query+=" pushedAt defaultBranchRef { target { ... on Commit { committedDate } } } }"
    done
    query+=" }"
    # Keyed by alias, not nameWithOwner: a renamed or moved repo answers with
    # its new name.
    while IFS=$'\t' read -r i stars updated; do
      printf '%s\t%s\t%s\n' "${batch[$i]}" "$stars" "$updated"
    done < <(gh api graphql -f query="$query" 2>/dev/null | jq -r '.data // {} | to_entries[] | select(.value != null) |
      [(.key | ltrimstr("r")), .value.stargazerCount,
       ((.value.defaultBranchRef.target.committedDate // .value.pushedAt // "-") | .[0:10])] | @tsv')
  done
}

build_index() {
  local page work cards count

  mkdir -p "$PREVIEW_DIR"
  work=$(mktemp -d)
  trap 'rm -rf "$work"' RETURN

  page=$(curl -fsSL --max-time 30 "$SITE/themes/") || return 1

  # Each card: <a href="<repo>"><img src="/assets/themes/<x>.webp" ...><span>Name</span></a>.
  # Repos are held to plain GitHub owner/name, which also keeps them safe to
  # hand to git and to the install command line.
  grep -oE '<li><a href="https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?"[^>]*><img src="/assets/themes/[A-Za-z0-9_.-]+"[^>]*><span[^>]*>[^<]+</span>' <<<"$page" |
    sed -E 's|.*href="([^"]+[^/"])/?".*src="([^"]+)".*<span[^>]*>([^<]+)</span>|\1\t\2\t\3|' |
    sed -E "s/&#39;|&#x27;/'/g; s/&quot;/\"/g; s/&amp;/\\&/g" >"$work/cards.tsv"

  count=$(grep -c . "$work/cards.tsv")
  (( count > 0 )) || return 1

  export -f probe_theme
  export APP_MAP_AWK PREVIEW_DIR SITE

  local n=0 repo preview name slug
  while IFS=$'\t' read -r repo preview name; do
    n=$((n + 1))
    slug=$(sed -E 's|https://github\.com/||; s|/|_|' <<<"$repo")
    printf '%s\0%s\0%s\0%s\0%s\0' "$n" "$repo" "$preview" "$slug" "$name"
  done <"$work/cards.tsv" |
    xargs -0 -n 5 -P 8 bash -c '
      result=$(probe_theme "$2" "$3" "$4" "'"$work"'") || exit 0
      [[ -n $result ]] || exit 0
      IFS=$'"'"'\t'"'"' read -r apps applist <<<"$result"
      printf "%s\t%s\t%s\t%s\t%s\n" "$apps" "$5" "$2" "$4" "$applist" >"'"$work"'/row.$1"
    ' _

  cat "$work"/row.* 2>/dev/null >"$work/rows.tsv"
  [[ -s $work/rows.tsv ]] || return 1

  cut -f 3 "$work/rows.tsv" | sed 's|https://github\.com/||' | fetch_stats >"$work/stats.tsv"
  awk -F '\t' 'BEGIN { OFS = "\t" }
    NR == FNR { stars[$1] = $2; updated[$1] = $3; next }
    { key = substr($3, 20); print $0, stars[key], updated[key] }' \
    "$work/stats.tsv" "$work/rows.tsv" >"$work/index.tsv"
  mv -f "$work/index.tsv" "$INDEX_FILE"
}

index_is_fresh() {
  [[ -s $INDEX_FILE ]] && [[ -z $(find "$INDEX_FILE" -mtime +$MAX_AGE_DAYS 2>/dev/null) ]]
}

# Most apps first, then the most stars, then the name.
sorted_index() {
  sort -t $'\t' -k1,1nr -k6,6nr -k2,2f "$INDEX_FILE"
}

# YYYY-MM-DD -> 3d, 5w, 4mo, 2y: compact, since the picker capitalises words.
age() {
  local days=$(( ($(date +%s) - $(date -d "$1" +%s)) / 86400 ))

  if (( days < 14 )); then
    printf '%dd' "$days"
  elif (( days < 60 )); then
    printf '%dw' $((days / 7))
  elif (( days < 365 )); then
    printf '%dmo' $((days / 30))
  else
    printf '%dy' $((days / 365))
  fi
}

# 1234 -> 1.2k
short_count() {
  if (( $1 >= 1000 )); then
    printf '%d.%dk' $(($1 / 1000)) $(($1 % 1000 / 100))
  else
    printf '%d' "$1"
  fi
}

# Same name omarchy-theme-install gives the clone.
installed_name() {
  basename -- "$1" .git | sed -E 's/^omarchy-//; s/-theme$//' | tr '[:upper:]' '[:lower:]'
}

mkdir -p "$CACHE_PATH"

if [[ $refresh == true ]] || ! index_is_fresh; then
  if [[ $list != true ]]; then
    notify-send -a omarchy -t 5000 "Theme catalog" "Reading the community themes from omarchy.org (about a minute)…"
  else
    echo "Reading the community themes from omarchy.org (about a minute)…" >&2
  fi

  if ! build_index && [[ ! -s $INDEX_FILE ]]; then
    notify-send -a omarchy -u critical "Theme catalog" "Could not read the themes from omarchy.org"
    echo "Could not read the themes from omarchy.org" >&2
    exit 1
  fi
fi

if [[ $list == true ]]; then
  {
    printf 'APPS\tSTARS\tUPDATED\tTHEME\tREPO\n'
    sorted_index | awk -F '\t' 'BEGIN { OFS = "\t" } { print $1, ($6 == "" ? "-" : $6), ($7 == "" ? "-" : $7), $2, $3 }'
  } | column -t -s $'\t'
  exit 0
fi

rm -rf "$LABEL_DIR"
mkdir -p "$LABEL_DIR"

# The picker labels each row after its file name, so the label carries the
# counts; it also filters on it (a name, "installed").
declare -A repo_for
rows=""
while IFS=$'\t' read -r apps name repo slug _ stars updated; do
  [[ -f $PREVIEW_DIR/$slug.webp ]] || continue

  case $apps in
  0) label="${name//\// } · colors only" ;;
  1) label="${name//\// } · 1 app" ;;
  *) label="${name//\// } · $apps apps" ;;
  esac
  [[ -n $stars ]] && label+=" · ★ $(short_count "$stars")"
  [[ $updated == ????-??-?? ]] && label+=" · ↻ $(age "$updated")"
  [[ -d $USER_THEMES_PATH/$(installed_name "$repo") ]] && label+=" · installed"

  link="$LABEL_DIR/$label.webp"
  [[ -e $link ]] && continue
  ln -s "$PREVIEW_DIR/$slug.webp" "$link"
  repo_for[$link]=$repo
  rows+="${rows:+$'\n'}$link"$'\t'"$link"
done < <(sorted_index)

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

# Same handshake omarchy-menu-images uses; rows go base64 through the shell IPC.
open_result=$(omarchy-shell image-selector open "" "$(printf '%s' "$rows" | base64 -w 0)" "" \
  "$selection_file" "$done_file" true true)
if [[ $open_result != "ok" ]]; then
  echo "Image selector failed to accept request" >&2
  exit 1
fi

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

selection=$(<"$selection_file")
[[ -n $selection && -n ${repo_for[$selection]} ]] || exit 0
repo=${repo_for[$selection]}

exec omarchy-launch-floating-terminal-with-presentation omarchy-theme-install "$repo"
