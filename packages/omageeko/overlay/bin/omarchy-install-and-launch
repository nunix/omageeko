#!/bin/bash

# omarchy:summary=Install a packaged app and launch it once it finishes
# omarchy:args=<display-name> <packages> <desktop-id>
# omarchy:examples=omarchy install and launch Cursor cursor-bin cursor
# omageeko: Tumbleweed port: packages resolve through pkgmap.tsv; when one is a
# Flathub app, launch it with `flatpak run <id>` (its desktop id differs from the
# Arch one, and a session started before the install lacks Flatpak's XDG_DATA_DIRS).

name="${1-}"
packages="${2-}"
desktop_id="${3-}"

if [[ -z $name || -z $packages || -z $desktop_id ]]; then
  echo "Usage: omarchy-install-and-launch <display-name> <packages> <desktop-id>" >&2
  exit 1
fi

source /usr/share/omageeko/lib/pkg.sh

read -r -d '' -a package_list <<<"$packages" || true

launch="gtk-launch $(printf '%q' "$desktop_id")"
for pkg in "${package_list[@]}"; do
  while read -r target; do
    if [[ $target == flatpak:* ]]; then
      launch="flatpak run $(printf '%q' "${target#flatpak:}")"
      break 2
    fi
  done < <(omageeko_pkg_resolve "$pkg")
done

printf -v install_message '%q' "Installing ${name}..."
printf -v packages_arg '%q ' "${package_list[@]}"
packages_arg="${packages_arg% }"

exec omarchy-launch-floating-terminal-with-presentation \
  "echo ${install_message}; omarchy-pkg-add ${packages_arg} && (setsid uwsm-app -- ${launch} >/dev/null 2>&1 &)"
