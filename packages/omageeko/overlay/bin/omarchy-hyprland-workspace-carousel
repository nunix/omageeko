#!/bin/bash

# omarchy:summary=Cycle through the focused monitor's occupied workspaces plus the next free one, up to 10
# omarchy:args=<left|right>
# omarchy:hidden=true
# omageeko: ported from nunix/omarchy-mac feature/workspace-carousel. Bound to
# the MX thumb wheel and 3-finger swipes in the host configs. Wraps around, so
# the wheel never stalls on an edge or jumps to a far empty workspace.
#
# Since Omarchy 4.5 every monitor has workspaces 1-10 of its own, numbered by
# Hyprland in a block of ten per monitor (default/hypr/monitor-workspaces.lua).
# The carousel works in slots of the focused monitor's block and focuses them
# through o.workspaces.focus, like Super + <n> and the bar.

slots=10

case ${1:-} in
left) step=-1 ;;
right) step=1 ;;
*)
  echo "Usage: omarchy-hyprland-workspace-carousel <left|right>" >&2
  exit 1
  ;;
esac

active_json=$(hyprctl activeworkspace -j) || exit 1
active=$(jq -r '.id' <<<"$active_json")
monitor=$(jq -r '.monitor' <<<"$active_json")

# The monitor's block, from the file Hyprland keeps them in; until it exists,
# the block of the workspace it shows
state=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/monitor-workspaces
block=$(awk -F '\t' -v monitor="$monitor" '$2 == monitor { print $1; exit }' "$state" 2>/dev/null)
if [[ -z $block ]]; then
  ((active >= 1)) || exit 0
  block=$(((active - 1) / slots))
fi
base=$((block * slots))

# Slots of this block on this monitor that hold windows
mapfile -t occupied < <(hyprctl workspaces -j | jq -r --arg monitor "$monitor" --argjson base "$base" --argjson slots "$slots" \
  '[.[] | select(.monitor == $monitor and .id > $base and .id <= $base + $slots and .windows > 0) | .id - $base] | sort | .[]')

max=0
for slot in "${occupied[@]}"; do
  ((slot > max)) && max=$slot
done

candidates=("${occupied[@]}")
((max < slots)) && candidates+=($((max + 1)))
active_slot=0
if ((active > base && active <= base + slots)); then
  active_slot=$((active - base))
  candidates+=("$active_slot")
fi
mapfile -t candidates < <(printf '%s\n' "${candidates[@]}" | sort -n -u)

index=-1
for i in "${!candidates[@]}"; do
  [[ ${candidates[i]} == "$active_slot" ]] && index=$i
done

count=${#candidates[@]}
if ((index < 0)); then
  # Showing a special or visiting workspace: enter the block at an edge
  ((step > 0)) && next=${candidates[0]} || next=${candidates[count - 1]}
else
  next=${candidates[(index + step + count) % count]}
fi

[[ $next == "$active_slot" ]] && exit 0
hyprctl dispatch "o.workspaces.focus($next, \"$monitor\")" >/dev/null
