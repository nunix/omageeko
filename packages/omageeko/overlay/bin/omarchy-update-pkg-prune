#!/bin/bash

# omarchy:summary=Prune superseded versions from the pacman package cache
# omarchy:requires-sudo=true
# omageeko: Tumbleweed port: cleans zypper's package cache (repository metadata is kept)

echo -e "\e[32m\nPrune package cache\e[0m"
sudo zypper --quiet clean || echo -e "\e[33mCould not prune the package cache.\e[0m" >&2
echo
