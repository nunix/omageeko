#!/bin/bash

# omarchy:summary=Update omageeko: Tumbleweed, then the Omarchy layer, then apps
# omarchy:args=[--check] [-y]
# omarchy:requires-sudo=true
# omageeko: replaces omarchy update. Three stages run in order and each one
# runs even when an earlier one had nothing to do or failed:
#   1 base      Tumbleweed snapshot: zypper dup from the openSUSE/Packman repos only
#   2 omageeko  newer Omarchy release (omageeko-bump, gated), rebuilt omageeko
#               RPMs, mise and the tools Omarchy installs with it, then Omarchy
#               migrations (Arch-only ones held for review)
#   3 apps      vendor app repos (Brave, Chrome, OBS add-ons…), Flatpak, the box
# Like Aeon, updates are applied right away (snapper keeps the pre-update
# state) and the summary says when a reboot or re-login makes them take effect.
# Stage 2 needs the omageeko checkout: `source=` in ~/.config/omageeko/update.conf,
# default ~/omageeko. Without it, stage 2 only runs pending migrations, still
# gated by the classifier shipped in /usr/share/omageeko/tools.

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omageeko
config=${XDG_CONFIG_HOME:-$HOME/.config}/omageeko/update.conf
source_dir=$(sed -n 's/^source=//p' "$config" 2>/dev/null)
source_dir=${source_dir/#\~/$HOME}
source_dir=${source_dir:-$HOME/omageeko}
[[ -x $source_dir/tools/omageeko-bump ]] || source_dir=""

declare -A result
stages=(base omageeko apps)

say() { echo -e "\e[1;34m[omageeko-update]\e[0m $*"; }
warn() { echo -e "\e[33m[omageeko-update] $*\e[0m" >&2; }
set_result() { result[$1]=$2; }

# Enabled zypper repos by stage, from their URLs: Tumbleweed itself (openSUSE
# distribution repos, codecs, Packman) / the Omarchy layer (omageeko-local,
# mise) / vendor and add-on app repos (everything else, OBS home projects too)
declare -a base_repos=() omarchy_repos=() app_repos=()
while read -r alias url; do
  case "$alias" in
  omageeko-local | mise) omarchy_repos+=("$alias") ;;
  *)
    if [[ $url =~ opensuse\.org/(tumbleweed|update/tumbleweed|history|source|debug)|codecs\.opensuse\.org|/packman/ ]]; then
      base_repos+=("$alias")
    else
      app_repos+=("$alias")
    fi
    ;;
  esac
done < <(zypper --no-refresh lr -E -u 2>/dev/null | awk -F'|' '/^ *[0-9]+ *[|]/ { gsub(/ /, "", $2); gsub(/ /, "", $NF); print $2, $NF }')

repo_args() {
  local repo
  for repo in "$@"; do printf -- '--repo\n%s\n' "$repo"; done
}

# Package set fingerprint, to tell "updated" from "nothing to do"
rpm_state() { rpm -qa --qf '%{NVRA}\n' | sort | md5sum; }

# Installed name/version list, and the difference between two of them as
# "name old → new" (or "name new (new)") lines
rpm_versions() { rpm -qa --qf '%{NAME} %{VERSION}-%{RELEASE}\n' | sort -u -k1,1; }
rpm_changes() {
  join -a 2 -e '-' -o '0,1.2,2.2' "$1" "$2" |
    awk '$2 != $3 {
      old = $2; new = $3
      sub(/\.omageeko\.b[0-9]+/, "", old); sub(/\.omageeko\.b[0-9]+/, "", new)
      if ($2 == "-") print $1 " " new " (new)"
      else if (old == new) print $1 " (rebuilt)"
      else print $1 " " old " → " new
    }'
}

# Stage notes for the summary, "; "-separated
join_notes() {
  (($#)) || { echo "up to date"; return; }
  local IFS=$'\x1f'
  sed $'s/\x1f/; /g' <<<"$*"
}

# Summary form of a change list: names only
change_names() { awk '{ print $1 }' <<<"$1" | paste -sd' '; }

# zypper without the snapper plugin's per-transaction pre/post pair (see Snapshots)
zyp() { sudo env DISABLE_SNAPPER_ZYPP_PLUGIN=1 zypper "$@"; }

# Rebuild stale omageeko packages in the builder container, printing each one
# as it starts; sets `built` (space-separated) and returns the build status
# rebuild_packages [log name] : the stage 1 pre-build keeps its own log, so a
# failing stage 2 rebuild does not overwrite the error that blocked the dup
rebuild_packages() {
  local packages status out="$state_dir/${1:-build}.out"
  mapfile -t packages < <(cd "$source_dir/packages" && ls -d -- */ | tr -d /)
  (cd "$source_dir" && bash -c 'source lib/common.sh && check_builder_snapshot && build_packages "$@"' _ "${packages[@]}") 2>&1 |
    tee "$out" | sed -u -n 's/\x1b\[[0-9;]*m//g; s/^\[omageeko\] Building \(.*\)/      building \1…/p'
  status=${PIPESTATUS[0]}
  built=$(sed -n 's/\x1b\[[0-9;]*m//g; s/^\[omageeko\] Building //p' "$out" | awk '!seen[$0]++' | tr '\n' ' ')
  rebuild_count=${#packages[@]}
  return "$status"
}

# Progress: what a substage is doing, then its result
step() { echo -e "  \e[36m→\e[0m $*"; }
result_line() { echo -e "    \e[2m$*\e[0m"; }

check_only() {
  say "Checking (nothing is changed)"
  local snapshot
  snapshot=$(omarchy-update-available 2>/dev/null) && echo "  base/omageeko RPMs: $snapshot" || echo "  base: up to date"
  if [[ -n $source_dir ]]; then
    echo "  omageeko upstream: $("$source_dir/tools/omageeko-bump" check 2>&1 | tail -1)"
  fi
  echo "  mise tools: $(MISE_MINIMUM_RELEASE_AGE=0 mise outdated --json 2>/dev/null | jq '[.[] | select(.current != null)] | length' 2>/dev/null || echo "?") outdated"
  if ((${#app_repos[@]})); then
    mapfile -t args < <(repo_args "${app_repos[@]}")
    echo "  vendor apps: $(zypper --no-refresh -q list-updates "${args[@]}" 2>/dev/null | grep -c '^v ') update(s) (${app_repos[*]})"
  fi
  echo "  flatpak: $(flatpak remote-ls --updates --columns=application 2>/dev/null | wc -l) update(s)"
  exit 0
}

[[ ${1:-} == "--check" ]] && check_only

mkdir -p "$state_dir"
log="$state_dir/update.log"
if [[ -z ${OMAGEEKO_UPDATE_LOGGED:-} ]]; then
  exec env OMAGEEKO_UPDATE_LOGGED=1 script -qefc "$(printf '%q ' "$0" "$@")" "$log"
fi

omarchy-update-requires-free-space || exit 1

# One password prompt, kept fresh for long downloads and builds
sudo /usr/bin/true || exit 1
(while sleep 60; do kill -0 $$ 2>/dev/null || exit; sudo -n /usr/bin/true 2>/dev/null || exit; done) &
keepalive=$!
trap 'kill $keepalive 2>/dev/null' EXIT

# Snapshots the Aeon way (transactional-update --drop-if-no-change): one pre/post
# pair for the whole run instead of one per zypper transaction, dropped when no
# package changed, so the boot menu only gains entries for real updates. Pruning
# stays with snapper-cleanup.timer (running it inline waited on btrfs quotas).
snap_pre=""
if command -v snapper >/dev/null && sudo snapper list-configs 2>/dev/null | grep -q '^root '; then
  say "Snapshot"
  step "Recording the system before updating"
  if snap_pre=$(sudo snapper -c root create --type pre --print-number --cleanup-algorithm number \
    --description "omageeko-update"); then
    result_line "pre-update snapshot #$snap_pre"
  else
    snap_pre=""
    warn "Continuing without a snapshot."
  fi
fi
# omarchy-update-pacman and zyp pass this through sudo to zypper
export DISABLE_SNAPPER_ZYPP_PLUGIN=1
rpm_versions >"$state_dir/rpms.start"
omarchy-update-stay-awake start 2>/dev/null

# --- 1 base: Tumbleweed
say "1/3 Tumbleweed"
installed_snapshot=$(. /etc/os-release && echo "${VERSION_ID:-0}")
published_snapshot=$(timeout 10 curl -fsSL https://download.opensuse.org/tumbleweed/repo/oss/media.1/products 2>/dev/null |
  awk '{ print $NF }' | cut -d- -f1)
dup_repos=("${base_repos[@]}")
base_failed=0 prebuilt=0

step "Refreshing repositories"
zyp --non-interactive refresh >/dev/null 2>&1 && result_line "done" || result_line "refresh had errors (continuing)"

if [[ $published_snapshot =~ ^[0-9]{8}$ ]] && ((published_snapshot > installed_snapshot)); then
  step "Snapshot $installed_snapshot → $published_snapshot"
  if [[ -n $source_dir ]]; then
    # Packages built against Qt/Hyprland internals (quickshell, the titlebars
    # plugin…) block the dup unless their rebuild comes in the same transaction
    step "Pre-building omageeko packages for $published_snapshot (Qt/Hyprland ABI)"
    if OMAGEEKO_TARGET_SNAPSHOT=$published_snapshot rebuild_packages prebuild; then
      prebuilt=1
      result_line "${built:+rebuilt: $built}${built:-nothing to rebuild}"
    else
      result_line "pre-build failed (see $state_dir/prebuild.out); the dup may need a decision"
    fi
  fi
fi
# omageeko-local joins the dup so pre-built packages move together with the snapshot
[[ " ${omarchy_repos[*]} " == *" omageeko-local "* ]] && dup_repos+=(omageeko-local)
rpm_versions >"$state_dir/rpms.base-before"
if OMAGEEKO_DUP_FROM="${dup_repos[*]}" OMARCHY_UPDATE_UNATTENDED=1 omarchy-update-system-pkgs; then
  rpm_versions >"$state_dir/rpms.base-after"
  count=$(rpm_changes "$state_dir/rpms.base-before" "$state_dir/rpms.base-after" | grep -c .)
  now_snapshot=$(. /etc/os-release && echo "${VERSION_ID:-0}")
  if ((count == 0)); then
    set_result base "up to date (snapshot $now_snapshot)"
  elif [[ $now_snapshot != "$installed_snapshot" ]]; then
    set_result base "updated ($count packages, snapshot $installed_snapshot → $now_snapshot)"
  else
    set_result base "updated ($count packages)"
  fi
else
  base_failed=1
  set_result base "FAILED (zypper needs a decision: run sudo zypper dup in a terminal)"
fi

# --- 2 omageeko: upstream release, rebuilt RPMs, mise, migrations
say "2/3 omageeko"
omageeko_notes=()
if [[ -n $source_dir ]]; then
  step "Omarchy upstream: checking for a newer release"
  bump_check=$("$source_dir/tools/omageeko-bump" check 2>&1)
  if [[ $? == 10 ]]; then
    step "Omarchy ${bump_check%% *} available: running the gated bump (report: $source_dir/.bump/latest/report.md)"
    if "$source_dir/tools/omageeko-bump" run --apply --install >"$state_dir/bump.out" 2>&1; then
      result_line "bumped to ${bump_check%% *}"
      omageeko_notes+=("Omarchy bumped: ${bump_check%% *}")
    else
      result_line "held: the release needs porting"
      omageeko_notes+=("Omarchy ${bump_check%% *} held (needs porting), see $source_dir/.bump/latest/report.md")
    fi
  else
    result_line "$bump_check"
  fi

  # Rebuild what the new snapshot or a source change made stale (stamps skip the rest)
  step "Rebuild: syncing the builder container with this snapshot, then checking the packages"
  if ((base_failed && prebuilt)); then
    result_line "skipped: packages are already built for $published_snapshot, waiting for the Tumbleweed update"
  elif rebuild_packages; then
    result_line "${built:+rebuilt: $built}${built:-all $rebuild_count up to date}"
  else
    result_line "FAILED (see $state_dir/build.out)"
    omageeko_notes+=("FAILED rebuild: see $state_dir/build.out")
  fi
else
  step "No omageeko checkout: skipping the upstream check and rebuild"
fi

# The Omarchy layer's RPMs: rebuilt omageeko packages and mise itself. While
# the host waits for a snapshot its omageeko builds target, only mise moves.
stage2_repos=("${omarchy_repos[@]}")
if ((base_failed && prebuilt)); then
  stage2_repos=("${omarchy_repos[@]/omageeko-local/}")
  step "omageeko packages: held until the Tumbleweed update (they are built for $published_snapshot)"
fi
mapfile -t stage2_repos < <(printf '%s\n' "${stage2_repos[@]}" | grep .)
if ((${#stage2_repos[@]})); then
  step "Packages from ${stage2_repos[*]}: refreshing and updating"
  rpm_versions >"$state_dir/rpms.before"
  mapfile -t args < <(repo_args "${stage2_repos[@]}")
  zyp --non-interactive refresh "${stage2_repos[@]}" >/dev/null
  if zyp --non-interactive update "${args[@]}" >"$state_dir/omarchy-rpms.out" 2>&1; then
    rpm_versions >"$state_dir/rpms.after"
    changes=$(rpm_changes "$state_dir/rpms.before" "$state_dir/rpms.after")
    if [[ -n $changes ]]; then
      sed 's/^/      /' <<<"$changes"
      result_line "$(wc -l <<<"$changes") updated"
      omageeko_notes+=("updated: $(change_names "$changes")")
    else
      result_line "nothing to update"
    fi
  else
    result_line "FAILED (see $state_dir/omarchy-rpms.out)"
    omageeko_notes+=("FAILED installing omageeko/mise RPMs: see $state_dir/omarchy-rpms.out")
  fi
fi

# Tools Omarchy installs with mise (default CLIs, agents, language runtimes)
if command -v mise >/dev/null; then
  step "mise tools: checking for newer versions"
  outdated=$(MISE_MINIMUM_RELEASE_AGE=0 mise outdated --json 2>/dev/null)
  tools=$(jq -r 'to_entries | map(select(.value.current != null) | "\(.key) \(.value.current) → \(.value.latest)") | .[]' <<<"${outdated:-"{}"}" 2>/dev/null)
  if [[ -z $tools ]]; then
    result_line "all current ($(mise ls --global 2>/dev/null | awk '{print $1}' | sort -u | paste -sd' '))"
  elif omarchy-update-mise >"$state_dir/mise.out" 2>&1; then
    sed 's/^/      /' <<<"$tools"
    result_line "$(wc -l <<<"$tools") upgraded"
    omageeko_notes+=("mise tools: $(paste -sd, <<<"$tools" | sed 's/,/, /g')")
  else
    result_line "FAILED (see $state_dir/mise.out)"
    omageeko_notes+=("FAILED mise tools: see $state_dir/mise.out")
  fi
fi

# Migrations: decisions in migrations.tsv first (skip = mark done), then hold
# everything if an Arch-only one is still undecided
step "Omarchy migrations: checking pending ones"
classify=${source_dir:+$source_dir/tools/omageeko-bump}
classify=${classify:-/usr/share/omageeko/tools/omageeko-bump}
held="" pending="{}"
if [[ -x $classify ]]; then
  pending=$("$classify" classify --json 2>/dev/null)
  pending=${pending:-"{}"}
  for name in $(jq -r 'to_entries[] | select(.value == "skip" or .value == "hw-noop") | .key' <<<"$pending"); do
    touch "$HOME/.local/state/omarchy/migrations/$name"
  done
  held=$(jq -r 'to_entries[] | select(.value | startswith("arch:")) | .key' <<<"$pending" | tr '\n' ' ')
fi
# omageeko: the skips above are already marked done; only the rest still runs
skipped=$(jq '[.[] | select(. == "skip" or . == "hw-noop")] | length' <<<"$pending")
count=$(jq '[.[] | select(. != "skip" and . != "hw-noop")] | length' <<<"$pending")
if [[ -n ${held// /} ]]; then
  result_line "held: Arch-only and undecided: $held"
  omageeko_notes+=("migrations held (Arch-only, undecided): $held- see docs/bump-runbook.md#migration-arch")
elif ((count == 0)); then
  if ((skipped > 0)); then result_line "$skipped skipped (migrations.tsv)"; else result_line "none pending"; fi
elif {
  # omageeko: as upstream omarchy-update (4.5.0): migrations call the shell
  # over IPC, so restart a shell still running the code stage 2 replaced
  omarchy-restart-shell || true
  omarchy-migrate
} >"$state_dir/migrate.out" 2>&1; then
  result_line "$count handled"
  omageeko_notes+=("$count migration(s) run")
else
  result_line "FAILED (see $state_dir/migrate.out)"
  omageeko_notes+=("FAILED migration: see $state_dir/migrate.out")
fi
omageeko-link-skills >/dev/null
set_result omageeko "$(join_notes "${omageeko_notes[@]}")"

# --- 3 apps: vendor app repos, Flatpak, the Arch box
say "3/3 apps"
apps_notes=()
if ((${#app_repos[@]})); then
  step "Vendor repos (${app_repos[*]}): refreshing and updating"
  mapfile -t args < <(repo_args "${app_repos[@]}")
  rpm_versions >"$state_dir/rpms.before"
  zyp --non-interactive refresh "${app_repos[@]}" >/dev/null 2>&1
  if zyp --non-interactive update --auto-agree-with-licenses "${args[@]}" >"$state_dir/apps.out" 2>&1; then
    rpm_versions >"$state_dir/rpms.after"
    changes=$(rpm_changes "$state_dir/rpms.before" "$state_dir/rpms.after")
    if [[ -n $changes ]]; then
      sed 's/^/      /' <<<"$changes"
      result_line "$(wc -l <<<"$changes") updated"
      apps_notes+=("updated: $(change_names "$changes")")
    else
      result_line "nothing to update"
    fi
  else
    result_line "FAILED (see $state_dir/apps.out)"
    apps_notes+=("FAILED vendor apps: see $state_dir/apps.out")
  fi
fi
if command -v flatpak >/dev/null; then
  step "Flatpak: checking system and user apps"
  mapfile -t flatpaks < <({ flatpak remote-ls --system --updates --columns=application; flatpak remote-ls --user --updates --columns=application; } 2>/dev/null | sort -u)
  if ((${#flatpaks[@]} == 0)); then
    result_line "nothing to update ($(flatpak list --app --columns=application 2>/dev/null | wc -l) apps installed)"
  else
    printf '      %s\n' "${flatpaks[@]}"
    if sudo flatpak update --system --noninteractive -y >"$state_dir/flatpak.out" 2>&1; then
      flatpak update --user --noninteractive -y >>"$state_dir/flatpak.out" 2>&1 || true
      result_line "${#flatpaks[@]} updated"
      apps_notes+=("flatpak: ${flatpaks[*]}")
    else
      result_line "FAILED (see $state_dir/flatpak.out)"
      apps_notes+=("FAILED flatpak (system): see $state_dir/flatpak.out")
    fi
  fi
fi
if command -v omageeko-box >/dev/null && podman container exists omageeko-arch 2>/dev/null; then
  step "Arch box (omageeko-arch): updating its packages and re-exporting apps"
  if omageeko-box update >"$state_dir/box.out" 2>&1; then
    n=$(sed -n -E 's/^Packages? \(([0-9]+)\).*/\1/p' "$state_dir/box.out" | head -1)
    if [[ -n $n ]]; then
      result_line "$n package(s) updated"
      apps_notes+=("box: $n package(s)")
    else
      result_line "nothing to update"
    fi
  else
    result_line "FAILED (see $state_dir/box.out)"
    apps_notes+=("FAILED box update: see $state_dir/box.out")
  fi
fi
set_result apps "$(join_notes "${apps_notes[@]}")"

# Close the snapshot pair, or drop it when the run changed no package
if [[ -n $snap_pre ]]; then
  say "Snapshot"
  rpm_versions >"$state_dir/rpms.end"
  changes=$(rpm_changes "$state_dir/rpms.start" "$state_dir/rpms.end")
  changed=$(grep -c . <<<"$changes")
  if ((changed == 0)); then
    step "No package changed: dropping snapshot #$snap_pre"
    sudo snapper -c root delete "$snap_pre" && result_line "dropped (the boot menu is unchanged)"
  else
    important=no
    grep -q '^kernel-' <<<"$changes" && important=yes
    step "Closing the snapshot pair ($changed packages changed)"
    if snap_post=$(sudo snapper -c root create --type post --pre-number "$snap_pre" --print-number \
      --cleanup-algorithm number --description "omageeko-update: $changed packages" --userdata "important=$important"); then
      note=""
      [[ $important == yes ]] && note=" (kernel update: marked important, kept longer)"
      result_line "#$snap_pre → #$snap_post: boot the pre-update entry to roll back$note"
    fi
  fi
fi

omarchy-update-analyze-logs 2>/dev/null
omarchy-shell -q omarchy.system-update clear 2>/dev/null
omarchy-update-stay-awake stop 2>/dev/null

# --- summary, Aeon style: applied now, takes effect on reboot
reboot=""
[[ $(ls /usr/lib/modules | sort -V | tail -1) != "$(uname -r)" ]] && reboot="new kernel"
zypper needs-rebooting >/dev/null 2>&1
(($? == 102)) && reboot=${reboot:-core libraries or services updated}
# Desktop programs still running replaced binaries/libraries (a new Qt under
# quickshell, a new Hyprland): no reboot, but the session should restart
relogin=""
if [[ -z $reboot ]]; then
  session=$(zypper ps -s 2>/dev/null | awk -F'|' -v uid="$(id -u)" '$3 ~ uid { gsub(/^ +| +$/, "", $5); print $5 }' | sort -u)
  if grep -qiE '^(Hyprland|quickshell)' <<<"$session"; then
    relogin="restart the shell (Super+Shift+K or omarchy restart shell), or log out and back in for Hyprland"
  fi
fi
echo
say "Summary"
for stage in "${stages[@]}"; do
  printf '  %-9s %s\n' "$stage" "${result[$stage]}"
done
jq -n --arg base "${result[base]}" --arg omageeko "${result[omageeko]}" --arg apps "${result[apps]}" \
  --arg reboot "$reboot" --arg relogin "$relogin" --arg at "$(date -Is)" \
  '{at: $at, base: $base, omageeko: $omageeko, apps: $apps, reboot: $reboot, relogin: $relogin}' >"$state_dir/last-update.json"

status="Updates applied"
urgency=normal
if grep -q FAILED <<<"${result[*]}"; then
  status="Updates applied with problems"
  urgency=critical
  echo -e "\n\e[31m$status:\e[0m see the FAILED lines above (log: $log)"
fi
if [[ -n $reboot ]]; then
  echo -e "\n\e[32m$status.\e[0m Reboot to use them ($reboot)."
  omarchy-notification-send -u "$urgency" -g  "$status" "Reboot to use them ($reboot)" 2>/dev/null
elif [[ -n $relogin ]]; then
  echo -e "\n\e[32m$status.\e[0m No reboot needed; desktop programs were updated: $relogin."
  omarchy-notification-send -u "$urgency" -g  "$status" "Desktop updated: $relogin" 2>/dev/null
else
  echo -e "\n\e[32m$status.\e[0m No reboot needed."
  omarchy-notification-send -u "$urgency" -g  "$status" "No reboot needed" 2>/dev/null
fi
grep -q FAILED <<<"${result[*]}" && exit 1
exit 0
